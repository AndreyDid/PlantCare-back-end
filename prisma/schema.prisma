// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email    String  @unique
  name     String?
  city     String?
  windowDirections String[] @default([]) @map("window_directions")
  password String

  plants UserPlant[]

  @@map("users")
}

model PlantType {
  id String @id @default(cuid())

  name      String  @unique
  latinName String?

  light            String?
  wateringInterval Int? // дни
  temperatureMin   Int?
  temperatureMax   Int?

  description String?

  createdAt DateTime @default(now())

  userPlant UserPlant[]

  @@map("plant_types")
}

model UserPlant {
  id String @id @default(cuid())

  nickname  String?
  plantName String?
  location  String?

  photoUrl String?

  plantTypeId String?
  plantType   PlantType? @relation(fields: [plantTypeId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastWateredAt              DateTime?
  nextWateringAt             DateTime?
  wateringIntervalDays       Int?
  wateringIntervalSpringDays Int?
  wateringIntervalSummerDays Int?
  wateringIntervalAutumnDays Int?
  wateringIntervalWinterDays Int?
  lightLevel                 String?
  temperatureMin             Int?
  temperatureMax             Int?
  humidityMin                Int?
  humidityMax                Int?
  potType                    String?
  potSize                    String?
  soilType                   String?
  lastRepottedAt             DateTime?
  nextRepottingAt            DateTime?
  wateringAmountMl           Int?
  wateringNotes              String?
  fertilizingIntervalDays    Int?
  lastFertilizedAt           DateTime?
  nextFertilizingAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wateringLogs   WateringLog[]
  careEvents      PlantCareEvent[]
  reminders      Reminder[]
  plantDiagnosis PlantDiagnosis[]

  @@index([userId])
  @@index([plantTypeId])
  @@map("user_plants")
}

model WateringLog {
  id String @id @default(cuid())

  plantId String
  plant   UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  wateredAt DateTime @default(now())

  note String?

  @@map("watering_logs")
}

model PlantCareEvent {
  id String @id @default(cuid())

  plantId String @map("plant_id")
  plant   UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  type        String
  title       String?
  description String?
  eventAt     DateTime @default(now()) @map("event_at")
  amountMl    Int?     @map("amount_ml")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([plantId, eventAt])
  @@map("plant_care_events")
}

model Reminder {
  id String @id @default(cuid())

  plantId String
  plant   UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  intervalDays  Int
  lastTriggered DateTime?

  createdAt DateTime @default(now())

  @@map("reminders")
}

model PlantDiagnosis {
  id String @id @default(cuid())

  plantId String
  plant   UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  imageUrl String
  result   String?

  createdAt DateTime @default(now())

  @@map("plant_diagnosis")
}
