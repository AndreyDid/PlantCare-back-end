generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  email            String      @unique
  name             String?
  password         String
  city             String?
  windowDirections String[]    @default([]) @map("window_directions")
  refreshTokenHash String?     @map("refresh_token_hash")
  plants           UserPlant[]

  @@map("users")
}

model PlantType {
  id               String      @id @default(cuid())
  name             String      @unique
  latinName        String?
  light            String?
  wateringInterval Int?
  temperatureMin   Int?
  temperatureMax   Int?
  description      String?
  createdAt        DateTime    @default(now())
  userPlant        UserPlant[]

  @@map("plant_types")
}

model UserPlant {
  id                         String           @id @default(cuid())
  nickname                   String?
  plantTypeId                String?
  userId                     String           @map("user_id")
  lastWateredAt              DateTime?
  nextWateringAt             DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  photoUrl                   String?
  plantName                  String?
  fertilizingIntervalDays    Int?
  humidityMax                Int?
  humidityMin                Int?
  lastFertilizedAt           DateTime?
  lastRepottedAt             DateTime?
  lightLevel                 String?
  nextFertilizingAt          DateTime?
  nextRepottingAt            DateTime?
  potSize                    String?
  potType                    String?
  soilType                   String?
  temperatureMax             Int?
  temperatureMin             Int?
  wateringAmountMl           Int?
  wateringNotes              String?
  wateringIntervalDays       Int?
  wateringIntervalSummerDays Int?
  wateringIntervalWinterDays Int?
  wateringIntervalSpringDays Int?
  wateringIntervalAutumnDays Int?
  location                   String?
  careEvents                 PlantCareEvent[]
  plantDiagnosis             PlantDiagnosis[]
  reminders                  Reminder[]
  plantType                  PlantType?       @relation(fields: [plantTypeId], references: [id])
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wateringLogs               WateringLog[]

  @@index([userId])
  @@index([plantTypeId])
  @@map("user_plants")
}

model WateringLog {
  id        String    @id @default(cuid())
  plantId   String
  wateredAt DateTime  @default(now())
  note      String?
  plant     UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("watering_logs")
}

model PlantCareEvent {
  id          String    @id @default(cuid())
  plantId     String    @map("plant_id")
  type        String
  title       String?
  description String?
  eventAt     DateTime  @default(now()) @map("event_at")
  amountMl    Int?      @map("amount_ml")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  photoUrl    String?   @map("photo_url")
  plant       UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, eventAt])
  @@map("plant_care_events")
}

model Reminder {
  id            String    @id @default(cuid())
  plantId       String
  intervalDays  Int
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  plant         UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model PlantDiagnosis {
  id        String    @id @default(cuid())
  plantId   String
  imageUrl  String
  result    String?
  createdAt DateTime  @default(now())
  plant     UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("plant_diagnosis")
}
