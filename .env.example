# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/plant_care?schema=public"
# Supabase Session Pooler:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"
DATABASE_URL=""
DATABASE_SSL=false
JWT_SECRET="change-me-to-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
# For multiple frontend domains, separate URLs with commas:
# FRONTEND_URL="https://app.vercel.app,https://preview.vercel.app"
PORT=4200
NODE_ENV=development
# COOKIE_DOMAIN is usually unnecessary. Set it only for a shared custom domain.
# COOKIE_DOMAIN=".example.com"
# Optional override. Leave empty locally; set to true for HTTPS-only deployments if needed.
COOKIE_SECURE=true

S3_ENDPOINT="https://s3.regru.cloud"
S3_REGION="us-east-1"
S3_BUCKET="plant-care-photo"
S3_PUBLIC_URL="https://s3.regru.cloud/plant-care-photo/"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"

DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-v4-flash"
# Optional override, OpenAI-compatible endpoint by default:
# DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
